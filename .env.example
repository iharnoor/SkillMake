# SkillMake — environment template
# Copy to .env.local for local dev (npm run dev).
# For Cloudflare deploy, mirror these as wrangler secrets:
#   wrangler secret put ANTHROPIC_API_KEY
#   wrangler secret put HYDRADB_API_KEY
#   wrangler secret put HYDRADB_TENANT_ID
#   wrangler secret put ADMIN_TOKEN

# Optional: Anthropic API key — only needed to power the public docs→SKILL.md
# converter at /submit. Leave empty to ship curator-only (the marketplace still
# works; /submit shows a "curator-only right now" notice).
ANTHROPIC_API_KEY=

# Optional: HydraDB. If unset, marketplace search degrades to substring match
# and dedup-on-publish becomes a no-op.
# HYDRADB_TENANT_ID must point to a tenant you've already created on your plan;
# SkillMake namespaces its data inside that tenant via HYDRADB_SUB_TENANT_ID.
HYDRADB_API_KEY=
HYDRADB_TENANT_ID=
HYDRADB_SUB_TENANT_ID=skillmake-marketplace

# Optional: override the model (default: claude-sonnet-4-6)
# SKILLMAKE_MODEL=claude-opus-4-7

# Required to access /admin (curator vetting queue). Use a long random string —
# rotating it invalidates every existing curator session.
#   wrangler secret put ADMIN_TOKEN
ADMIN_TOKEN=
