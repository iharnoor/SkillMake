{
  "title": "skillmake observability",
  "uid": "skillmake-observability",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "skillmake",
    "cloudflare",
    "analytics-engine"
  ],
  "timezone": "browser",
  "refresh": "5m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Total installs (window)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ],
          "fields": "/installs/"
        },
        "graphMode": "none",
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource"
          },
          "type": "json",
          "source": "url",
          "url": "https://api.cloudflare.com/client/v4/accounts/f9d7efb12a2713ce5af52d882165c543/analytics_engine/sql",
          "url_options": {
            "method": "POST",
            "headers": [
              {
                "key": "Content-Type",
                "value": "text/plain"
              }
            ],
            "body_type": "raw",
            "body_content_type": "text/plain",
            "data": "SELECT sum(_sample_interval) AS installs FROM skillmake_metrics WHERE index1 = 'install_hit' AND timestamp >= NOW() - INTERVAL '14' DAY\nFORMAT JSON"
          },
          "root_selector": "data",
          "columns": [
            {
              "selector": "installs",
              "text": "installs",
              "type": "number"
            }
          ]
        }
      ]
    },
